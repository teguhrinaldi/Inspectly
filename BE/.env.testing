APP_NAME=Inspectly
APP_ENV=testing
APP_KEY=base64:TjDGi3nxdDmHb7T5Suk4/W8/b8LKTxtCp/12dYtl+9g=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default fast path for local iteration: SQLite in-memory, no server needed.
# To run the suite against real MySQL instead (e.g. to catch MySQL-specific
# issues before a release), temporarily swap these four lines for:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=inspectly_testing
#   DB_USERNAME=root
#   DB_PASSWORD=
# then run `php artisan test`, then revert back to sqlite/:memory: below.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
